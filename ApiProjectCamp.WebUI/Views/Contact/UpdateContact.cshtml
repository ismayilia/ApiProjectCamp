@model GetContactByIdDto
@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
	<div class="section-body">
		<div class="row">
			<div class="col-12 col-md-12 col-lg-12">
				<div class="card">
					<div class="card-header">
						<h4>Update Contact</h4>
					</div>
					<div class="card-body">
						<form method="post">
							<input type="hidden" asp-for="ContactId">
							<label asp-for="Address">Address</label>
							<input type="text" asp-for="Address" class="form-control" />
							<br>
							<label asp-for="Phone">Phone</label>
							<input type="number" asp-for="Phone" class="form-control" />
							<br>
							<label asp-for="Email">Email</label>
							<input type="email" asp-for="Email" class="form-control" />
							<br>
							<label asp-for="OpenHours">Oper Hours</label>
							<input type="text" asp-for="OpenHours" class="form-control" />
							<br>
							<label asp-for="MapLocation">Map Location Detail</label>
							<input type="text" asp-for="MapLocation" class="form-control" />
							<br>
							<button class="btn btn-primary">Update Contact</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>


