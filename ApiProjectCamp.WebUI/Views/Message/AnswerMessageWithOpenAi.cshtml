@model GetMessageByIdDto

@{
	ViewData["Title"] = "AnswerMessageWithOpenAi";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
	<div class="section-body">
		<div class="row">
			<div class="col-12 col-md-12 col-lg-12">
				<div class="card">
					<div class="card-header">
						<h4>Automatic Message Reply Page with OpenAI</h4>
					</div>
					<div class="card-body">
						<form method="post">
							<input type="hidden" asp-for="MessageId">
							<label asp-for="MessageDetails">Customer Message</label>
							<textarea class="form-control" asp-for="MessageDetails" style="height:200px !important"></textarea>
							<br>

							<label>OpenAI Automatic Response</label>
							<textarea class="form-control" style="height:200px !important">@ViewBag.answerAI</textarea>
							<br>

							<button class="btn btn-primary">Send the response by email</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>


